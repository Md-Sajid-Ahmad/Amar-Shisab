{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Account": {
      "title": "Account",
      "description": "User ledger account",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "iconEmoji": { "type": "string" },
        "colorHex": { "type": "string" },
        "localId": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "iconEmoji", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "User expense or income transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "integer" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["EXPENSE", "REFUND"] },
        "notes": { "type": "string" },
        "timestamp": { "type": "integer" },
        "yearMonth": { "type": "string" },
        "localAccountId": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "description", "category", "type", "timestamp", "yearMonth", "createdAt", "updatedAt"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "User monthly target budget",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "yearMonth": { "type": "string" },
        "targetBudget": { "type": "integer" },
        "startingBalance": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "yearMonth", "targetBudget", "startingBalance", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "User ledger accounts"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transaction records"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "MonthlyBudget",
      "description": "User monthly budgets"
    }
  }
}
